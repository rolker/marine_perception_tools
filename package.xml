<?xml version="1.0"?>
<package format="3">
  <name>marine_perception_tools</name>
  <version>0.0.0</version>
  <description>
    Operator-station tools for marine perception. Hosts sea_surface_tuner, an
    offline C++/Qt application to replay recorded bags and tune the
    segmentation-to-costmap marking against them. Lives in ui_ws (operator
    station only) so its Qt dependency stays off the boat-side host.
  </description>

  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>qtbase5-dev</depend>
  <depend>sea_surface_segmentation</depend>
  <depend>grid_map_core</depend>
  <depend>image_geometry</depend>
  <depend>marine_acoustic_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>ffmpeg_encoder_decoder</depend>
  <depend>ffmpeg_image_transport_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>libopencv-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
